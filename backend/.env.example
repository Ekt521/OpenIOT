# 后端环境变量示例
#
# Spring Boot 的环境变量命名规则：点换成下划线、去掉连字符、转成大写。
# 例如 openiot.mqtt.broker-url 对应 OPENIOT_MQTT_BROKERURL。
#
# 这些变量适合容器或服务方式部署时使用。本机开发直接改
# backend/src/main/resources/application.yml，或用命令行参数覆盖即可：
#   mvn -f backend/pom.xml spring-boot:run "-Dspring-boot.run.arguments=--openiot.mqtt.broker-url=tcp://192.168.1.20:1883"

# 数据库
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/openiot
SPRING_DATASOURCE_USERNAME=openiot
SPRING_DATASOURCE_PASSWORD=openiot

# MQTT Broker（Broker 开启认证后必须填写账号密码）
OPENIOT_MQTT_BROKERURL=tcp://localhost:1883
OPENIOT_MQTT_USERNAME=
OPENIOT_MQTT_PASSWORD=

# 设备判定
OPENIOT_DEVICE_OFFLINETHRESHOLDSECONDS=90
OPENIOT_DEVICE_COMMANDTIMEOUTSECONDS=15

# 管理员账号（上线前请修改密码）
OPENIOT_SECURITY_ADMINEMAIL=lin.yuan@example.com
OPENIOT_SECURITY_ADMINPASSWORD=openiot
OPENIOT_SECURITY_ADMINNAME=林远

# 开发用设备模拟器，生产环境保持 false
OPENIOT_SIMULATOR_ENABLED=false
