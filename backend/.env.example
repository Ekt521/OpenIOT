# 后端环境变量示例：复制为 backend/.env 后填写真实值。
# backend/.env 已被 Git 忽略。也可以把值写入
# backend/config/application-local.yml 并启用 local profile。
#
# Spring Boot 的环境变量命名规则：点换成下划线、去掉连字符、转成大写。
# 例如 openiot.mqtt.broker-url 对应 OPENIOT_MQTT_BROKER_URL。

# 数据库
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/openiot
SPRING_DATASOURCE_USERNAME=openiot
SPRING_DATASOURCE_PASSWORD=change-me

# MQTT Broker（Broker 开启认证后必须填写账号密码）
OPENIOT_MQTT_BROKER_URL=tcp://localhost:1883
OPENIOT_MQTT_CLIENT_ID=openiot-platform
OPENIOT_MQTT_USERNAME=
OPENIOT_MQTT_PASSWORD=

# 设备判定
OPENIOT_DEVICE_OFFLINETHRESHOLDSECONDS=90
OPENIOT_DEVICE_COMMANDTIMEOUTSECONDS=15

# 管理员账号
OPENIOT_SECURITY_ADMIN_EMAIL=admin@example.com
OPENIOT_SECURITY_ADMIN_PASSWORD=change-me
OPENIOT_SECURITY_ADMIN_NAME=管理员

# 开发用设备模拟器，生产环境保持 false
OPENIOT_SIMULATOR_ENABLED=false

# 小米电视局域网适配器（电视 IP 变化后改这里并重启后端）
OPENIOT_TV_ENABLED=false
OPENIOT_TV_IP=127.0.0.1
OPENIOT_TV_PORT=6095
OPENIOT_TV_CODE=CHANGE-ME-TV
OPENIOT_TV_NAME=客厅电视
OPENIOT_TV_PRODUCT_NAME=电视
OPENIOT_TV_LOCATION=
OPENIOT_TV_TIMEOUT_MILLIS=3000
OPENIOT_TV_POLL_INTERVAL_MILLIS=15000
